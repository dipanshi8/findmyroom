<% if (messages.success) { %>
    <div class="bg-green-500 text-white p-4 rounded shadow-lg mb-4">
        <%= messages.success[0] %>
    </div>
<% } %>

<% if (messages.error) { %>
    <div class="bg-red-100 text-red-700 p-2 rounded mb-4">
        <%= messages.error[0] %>
    </div>
<% } %>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tenant Onboarding</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#f9dbbd] py-8">
    <form id="tenantForm" action="/tenant/onboarding" method="POST" enctype="multipart/form-data">

        <!-- A. Personal Information -->
        <h2 class="text-white bg-[#6e4555] text-lg font-semibold px-4 py-2 rounded-md mb-4">A. Personal Information</h2>

        <div class="space-y-4">
            <div>
                <label class="block text-[#6e4555] mb-1">Full Name</label>
                <input type="text" name="fullName" placeholder="Enter your full name" required
                    class="w-full border border-[#6e4555] rounded-md p-2" />
            </div>

            <div>
                <label class="block text-[#6e4555] mb-1">Profile Picture <span class="italic text-sm">(Optional)</span></label>
                <input type="file" name="profilePic" accept="image/*"
                    class="w-full border border-[#6e4555] rounded-md p-2 bg-white" />
            </div>

            <div>
                <label class="block text-[#6e4555] mb-1">Date of Birth</label>
                <input type="date" name="dob" required
                    class="w-full border border-[#6e4555] rounded-md p-2" />
            </div>

            <div>
                <label class="block text-[#6e4555] mb-1">Gender</label>
                <select name="gender" required
                    class="w-full border border-[#6e4555] rounded-md p-2">
                    <option value="">Select</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div>
                <label class="block text-[#6e4555] mb-1">Email ID</label>
                <div class="flex gap-2">
                    <input type="email" name="email" placeholder="Enter your email" required
                        class="w-full border border-[#6e4555] rounded-md p-2" />
                    <button type="button" onclick="sendOTP('email')"
                        class="px-4 py-2 border border-[#6e4555] text-[#6e4555] rounded-md hover:bg-[#f1c9a4]">Send OTP</button>
                </div>
            </div>

            <div>
                <label class="block text-[#6e4555] mb-1">Mobile Number</label>
                <div class="flex gap-2">
                    <input type="tel" name="mobile" pattern="[0-9]{10}" placeholder="Enter your mobile number" required
                        class="w-full border border-[#6e4555] rounded-md p-2" />
                    <button type="button" onclick="sendOTP('mobile')"
                        class="px-4 py-2 border border-[#6e4555] text-[#6e4555] rounded-md hover:bg-[#f1c9a4]">Send OTP</button>
                </div>
            </div>

            <div>
                <label class="block text-[#6e4555] mb-1">Occupation</label>
                <select name="occupation" required
                    class="w-full border border-[#6e4555] rounded-md p-2">
                    <option value="">Select</option>
                    <option value="Student">Student</option>
                    <option value="Working Professional">Working Professional</option>
                </select>
            </div>

            <div>
                <label class="block text-[#6e4555] mb-1">College / Company Name</label>
                <input type="text" name="institution" placeholder="Enter your college/company name" required
                    class="w-full border border-[#6e4555] rounded-md p-2" />
            </div>

            <div>
                <label class="block text-[#6e4555] mb-1">College ID / Work ID Upload <span class="italic text-sm">(Optional)</span></label>
                <input type="file" name="idUpload"
                    class="w-full border border-[#6e4555] rounded-md p-2 bg-white" />
            </div>
        </div>

        <!-- B. KYC -->
        <h2 class="text-white bg-[#6e4555] text-lg font-semibold px-4 py-2 rounded-md my-6">B. KYC</h2>

        <div class="space-y-4">
            <div>
                <label class="block text-[#6e4555] mb-1">Aadhaar Number (Masked & Secure)</label>
                <input type="password" name="aadhaar" pattern="[0-9]{12}" placeholder="Enter Aadhaar number" required
                    class="w-full border border-[#6e4555] rounded-md p-2" />
            </div>

            <div>
                <label class="block text-[#6e4555] mb-1">DigiLocker Link</label>
                <input type="url" name="digilocker" placeholder="Paste your DigiLocker link" required
                    class="w-full border border-[#6e4555] rounded-md p-2" />
            </div>

            <div>
                <label class="block text-[#6e4555] mb-1">PAN (For rent agreements)</label>
                <input type="text" name="pan" pattern="[A-Z]{5}[0-9]{4}[A-Z]{1}" placeholder="Enter PAN number" required
                    class="w-full border border-[#6e4555] rounded-md p-2" />
            </div>
        </div>

        <!-- C. Account Preferences Setup -->
        <h2 class="text-white bg-[#6e4555] text-lg font-semibold px-4 py-2 rounded-md my-6">C. Account Preferences Setup</h2>

        <div class="space-y-4">
            <div>
                <label class="block text-[#6e4555] mb-1">Language Preference</label>
                <select name="language"
                    class="w-full border border-[#6e4555] rounded-md p-2">
                    <option value="English">English</option>
                    <option value="Hindi">Hindi</option>
                </select>
            </div>

            <div>
                <label class="block text-[#6e4555] mb-1">Currency</label>
                <select name="currency"
                    class="w-full border border-[#6e4555] rounded-md p-2">
                    <option value="INR">INR</option>
                    <option value="USD">USD</option>
                    <option value="EUR">EUR</option>
                </select>
            </div>

            <div>
                <label class="block text-[#6e4555] mb-1">Notifications</label>
                <div class="flex gap-4 mt-2">
                    <label class="flex items-center gap-2 text-[#6e4555]">
                        <input type="checkbox" name="notify_email" checked class="accent-[#6e4555]" /> Email
                    </label>
                    <label class="flex items-center gap-2 text-[#6e4555]">
                        <input type="checkbox" name="notify_sms" checked class="accent-[#6e4555]" /> SMS
                    </label>
                    <label class="flex items-center gap-2 text-[#6e4555]">
                        <input type="checkbox" name="notify_app" checked class="accent-[#6e4555]" /> App
                    </label>
                </div>
            </div>
        </div>

        <button type="submit"
            class="bg-[#6e4555] text-white mt-8 w-full py-3 rounded-md hover:bg-[#573345] transition">
            Submit
        </button>
    </form>

    <script>
        function sendOTP(type) {
            alert('OTP sent to your ' + type + ' (Mock Function)');
        }
    </script>
</body>
</html>
