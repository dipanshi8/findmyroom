<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tenant Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-teal-50 min-h-screen p-6">
  <div class="max-w-3xl mx-auto bg-white p-6 rounded-xl shadow-lg">
    <h1 class="text-3xl font-bold text-teal-600 mb-4">Welcome, <%= user.name %>!</h1>
    <p class="mb-2">📞 Phone: <%= user.phone %></p>
    <p class="mb-2">🏠 Address: <%= user.address %></p>
    <p class="mb-2">🎓 College: <%= user.college %></p>
    <p class="mb-2">📅 Year: <%= user.year %></p>
    <p class="mb-2">🧑 Gender: <%= user.gender %></p>

    <div class="mt-6">
      <a href="/logout" class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600">
        Logout
      </a>
    </div>
  </div>
</body>
</html>
