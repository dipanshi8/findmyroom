<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tenant Registration</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white text-gray-800">
  <div class="max-w-xl mx-auto mt-12 bg-white shadow-xl p-8 rounded-xl border border-gray-200">
    <h1 class="text-2xl font-bold text-center text-teal-600 mb-6">Complete Your Tenant Profile</h1>
    <form method="POST" action="/tenant/register" class="space-y-4">
      <input type="text" name="name" placeholder="Full Name" class="w-full p-2 border rounded-lg" required />
      <input type="tel" name="phone" placeholder="Phone Number" class="w-full p-2 border rounded-lg" required />
      <select name="gender" class="w-full p-2 border rounded-lg" required>
        <option value="">Select Gender</option>
        <option value="male">Male</option>
        <option value="female">Female</option>
        <option value="other">Other</option>
      </select>
      <input type="text" name="address" placeholder="Address" class="w-full p-2 border rounded-lg" required />
      <input type="text" name="college" placeholder="College Name" class="w-full p-2 border rounded-lg" required />
      <input type="text" name="year" placeholder="Year of Study" class="w-full p-2 border rounded-lg" required />
      <button type="submit" class="bg-teal-500 text-white px-4 py-2 rounded hover:bg-teal-600 w-full">
        Register as Tenant
      </button>
    </form>
  </div>
</body>
</html>
